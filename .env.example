# SmartRetail local environment. Copy to .env (make does this for you).
# Every value here is a safe local default; .env is gitignored.

# --- Shared --------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
OTEL_SDK_DISABLED=true

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
IDENTITY_DB_PASSWORD=identity_local
CATALOG_DB_PASSWORD=catalog_local
ORDER_DB_PASSWORD=order_local
INVENTORY_DB_PASSWORD=inventory_local
TEMPORAL_DB_PASSWORD=temporal_local
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- JWT (RS256) ---------------------------------------------------------
# Written by `make keys`.
JWT_ACTIVE_KID=
JWT_ISSUER=smartretail-identity
JWT_AUDIENCE=smartretail
JWT_LEEWAY_SECONDS=10
JWKS_MIN_REFETCH_SECONDS=30
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# --- Service tokens (client credentials, RFC 0003 IDN-T3) ------------------
# Written by `make keys`: the workers hold the secret, identity only its digest.
SERVICE_CLIENT_SECRET=
SERVICE_CLIENT_SECRET_SHA256=

# --- Temporal (RFC 0001 §3.1.1.10) -----------------------------------------
# Host port of the Temporal UI; change it if 8080 is taken.
TEMPORAL_UI_PORT=8080

# --- Object storage (MinIO, RFC 0004 B12) ----------------------------------
MINIO_ROOT_USER=smartretail
MINIO_ROOT_PASSWORD=change-me-minio-password

# --- identity ------------------------------------------------------------
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4
SEED_ADMIN_EMAIL=admin@smartretail.local
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_DEMO_PASSWORD=change-me-demo-password

# --- gateway -------------------------------------------------------------
GATEWAY_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
GATEWAY_PUBLIC_URL=http://localhost:8000
GATEWAY_MAX_BODY_BYTES=1048576
GATEWAY_MAX_UPLOAD_BYTES=10485760
GATEWAY_UPSTREAM_CONNECT_TIMEOUT_S=2
GATEWAY_UPSTREAM_READ_TIMEOUT_S=10
