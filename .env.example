# SmartRetail local environment. Copy to .env (make does this for you).
# Every value here is a safe local default; .env is gitignored.

# --- Shared --------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
OTEL_SDK_DISABLED=true

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
IDENTITY_DB_PASSWORD=identity_local
CATALOG_DB_PASSWORD=catalog_local
ORDER_DB_PASSWORD=order_local
INVENTORY_DB_PASSWORD=inventory_local
TEMPORAL_DB_PASSWORD=temporal_local
# outbox-relay's login (RFC 0001 PLT-3): reads and marks outbox rows only.
OUTBOX_RELAY_DB_PASSWORD=outbox_relay_local
NOTIFICATION_DB_PASSWORD=notification_local
ASSISTANT_DB_PASSWORD=assistant_local
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- JWT (RS256) ---------------------------------------------------------
# Written by `make keys`.
JWT_ACTIVE_KID=
JWT_ISSUER=smartretail-identity
JWT_AUDIENCE=smartretail
JWT_LEEWAY_SECONDS=10
JWKS_MIN_REFETCH_SECONDS=30
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# --- Service tokens (client credentials, RFC 0003 IDN-T3) ------------------
# Written by `make keys`: the workers hold the secret, identity only its digest.
SERVICE_CLIENT_SECRET=
SERVICE_CLIENT_SECRET_SHA256=

# --- Temporal (RFC 0001 §3.1.1.10) -----------------------------------------
# Host port of the Temporal UI; change it if 8080 is taken.
TEMPORAL_UI_PORT=8080

# --- Events and Celery (RFC 0001 §3.1.1.6–§3.1.1.7, Milestone 3) ----------
# RabbitMQ is Celery's broker; its management UI is on 127.0.0.1:15672.
RABBITMQ_DEFAULT_USER=smartretail
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-password
# true: run inventory's expiry sweeper in-process instead of on Celery Beat.
INVENTORY_SWEEPER_INPROCESS=false
# Retry-path demo: fraction of fake email sends that fail (0.0–1.0).
NOTIFICATION_FAKE_EMAIL_FAILURE_RATE=0.0

# --- analytics (RFC 0008): MongoDB analytics_db, replica set rs0, keyfile auth (ANL-D36)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-mongo-root-password
ANALYTICS_MONGO_PASSWORD=analytics_local
ANALYTICS_REPORTING_CURRENCY=USD

# --- assistant (RFC 0009, Milestone 3) -------------------------------------
# Providers default to deterministic, key-less doubles; a real provider
# refuses to start without its key. LLM_PROVIDER: scripted | anthropic.
LLM_PROVIDER=scripted
LLM_MODEL=claude-sonnet-5-5
LLM_CLASSIFIER_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# EMBEDDING_PROVIDER: hashing | voyage (switching needs `make reindex`).
EMBEDDING_PROVIDER=hashing
VOYAGE_API_KEY=
DAILY_TOKEN_BUDGET_USER=50000
DAILY_TOKEN_BUDGET_GLOBAL=2000000

# --- Object storage (MinIO, RFC 0004 B12) ----------------------------------
MINIO_ROOT_USER=smartretail
MINIO_ROOT_PASSWORD=change-me-minio-password

# --- identity ------------------------------------------------------------
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4
SEED_ADMIN_EMAIL=admin@smartretail.local
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_DEMO_PASSWORD=change-me-demo-password

# --- gateway -------------------------------------------------------------
GATEWAY_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
GATEWAY_PUBLIC_URL=http://localhost:8000
GATEWAY_MAX_BODY_BYTES=1048576
GATEWAY_MAX_UPLOAD_BYTES=10485760
GATEWAY_UPSTREAM_CONNECT_TIMEOUT_S=2
GATEWAY_UPSTREAM_READ_TIMEOUT_S=10
