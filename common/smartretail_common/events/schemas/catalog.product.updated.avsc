{
  "type": "record",
  "name": "ProductUpdated",
  "namespace": "smartretail.events.payload",
  "fields": [
    {
      "name": "product_id",
      "type": "string"
    },
    {
      "name": "merchant_id",
      "type": "string"
    },
    {
      "name": "version",
      "type": "long"
    },
    {
      "name": "sku",
      "type": "string"
    },
    {
      "name": "name",
      "type": "string"
    },
    {
      "name": "status",
      "type": "string"
    },
    {
      "name": "category_id",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "base_price",
      "type": "string"
    },
    {
      "name": "currency",
      "type": "string"
    },
    {
      "name": "published_at",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "variants",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "ProductVariant",
          "namespace": "smartretail.events.payload",
          "fields": [
            {
              "name": "variant_id",
              "type": "string"
            },
            {
              "name": "sku",
              "type": "string"
            },
            {
              "name": "options",
              "type": "string",
              "sr.json": true
            },
            {
              "name": "price_override",
              "type": [
                "null",
                "string"
              ],
              "default": null
            },
            {
              "name": "is_active",
              "type": "boolean"
            }
          ]
        }
      }
    },
    {
      "name": "search_document",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "sr.json": true
    },
    {
      "name": "changed_fields",
      "type": {
        "type": "array",
        "items": "string"
      },
      "default": []
    }
  ],
  "doc": "RFC 0004 \u00a73.1.2.3: the product's full public state. options and search_document are free-form JSON carried as a JSON string."
}
